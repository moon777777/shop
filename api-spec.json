{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop 프로젝트 API",
    "description": "백엔드 API 명세서",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "OAuth 로그인/회원가입",
        "description": "클라이언트에서 OAuth 제공자(accessToken)를 전달하면, 신규 사용자는 회원가입 후 로그인, 기존 사용자는 로그인 처리",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/auth_oauth_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthLoginResponse"
                },
                "example": {
                  "jwtToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.abc123.def456",
                  "refreshToken": "rft_1234567890",
                  "user": {
                    "id": 1,
                    "email": "youngju@example.com",
                    "name": "영주",
                    "phone": "010-1234-5678",
                    "createdAt": "2025-11-27T16:00:00Z",
                    "updatedAt": "2025-11-27T16:05:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않은 토큰",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "Invalid access token"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reissue": {
      "post": {
        "summary": "액세스 토큰 재발급",
        "description": "리프레시 토큰을 이용해 새로운 Access Token과 Refresh Token을 재발급합니다.기존 Refresh Token은 폐기됩니다. (Refresh Token Rotation)" ,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReissueTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "새로운 Access Token 발급",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                },
                "example": {
                  "jwtToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.newtoken123",
                  "refreshToken": "rft_new_987654321"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않은 리프레시 토큰",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "Invalid refresh token"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "로그아웃",
        "description": "서버에 저장된 리프레시 토큰을 삭제하여 로그아웃 처리",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReissueTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "로그아웃 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_1"
                },
                "example": {
                  "message": "Logged out successfully"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "본인 정보 조회",
        "description": "로그인된 사용자의 기본 정보를 조회합니다. (이름, 연락처, 이메일, 배송지 포함), 주소는 사용자의 기본 배송지 1개만 반환합니다.",
        "responses": {
          "200": {
            "description": "사용자 정보 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                },
                "example": {
                  "name": "영주",
                  "email": "youngju@example.com",
                  "phone": "010-1234-5678",
                  "address": {
                    "zipcode": "12345",
                    "road": "서울특별시 강남구 123",
                    "detail": "101동 1001호"
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "Unauthorized"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "summary": "본인 정보 수정",
        "description": "사용자의 이름과 연락처 정보를 수정합니다.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              },
              "example": {
                "name": "홍길동",
                "phone": "010-1234-5678"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "수정된 사용자 정보 반환",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                },
                "example": {
                  "name": "홍길동",
                  "email": "youngju@example.com",
                  "phone": "010-1234-5678",
                  "address": [
                  {
                    "addressId": 1,
                    "zipcode": "12345",
                    "road": "서울 ...",
                    "detail": "...",
                    "isDefault": true
                  },
                  {
                    "addressId": 2,
                    "zipcode": "54321",
                    "road": "부산 ...",
                    "detail": "...",
                    "isDefault": false
                  }
                ]
                }
              }
            }
          },
          "400": {
            "description": "필수 필드 누락 또는 유효하지 않은 값",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "Missing required fields: name, phone"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "Unauthorized"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/me/addresses": {
      "post": {
        "summary": "배송지 등록",
        "description": "사용자의 배송지를 신규 등록합니다.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "배송지 등록 성공"
          },
          "400": {
            "description": "필수 필드 누락"
          },
          "409": {
            "description": "배송지 최대 등록 개수 초과 (예: 최대 5개)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/me/addresses/{addressId}": {
      "patch": {
  "summary": "배송지 수정 (기본 배송지 설정 포함)",
  "description": "배송지 정보를 수정합니다. isDefault=true인 경우 해당 배송지를 기본 배송지로 설정하며, 기존 기본 배송지는 자동 해제됩니다.",
  "parameters": [
    {
      "name": "addressId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "integer"
      }
    }
  ],
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/AddressUpdateRequest"
        },
        "example": {
          "name": "집",
          "zipcode": "12345",
          "road": "서울특별시 강남구 테헤란로 123",
          "detail": "101동 1001호",
          "isDefault": true
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "수정된 배송지 정보",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Address"
          }
        }
      }
    },
    "400": {
      "description": "잘못된 요청"
    },
    "401": {
      "description": "인증 필요"
    },
    "403": {
      "description": "타인의 배송지 수정 시도",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      }
    },
    "404": {
      "description": "배송지 없음"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
},
      "delete": {
        "summary": "배송지 삭제",
        "description": "등록된 배송지 정보를 삭제합니다.",
        "parameters": [
          {
            "name": "addressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "배송지 삭제 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_2"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          },
          "403": {
            "description": "타인의 배송지 삭제 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "배송지 없음"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/products": {
      "get": {
        "summary": "전체 상품 목록 조회",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          {
            "name": "sort",
            "in": "query",
            "schema": { "type": "string", "enum": ["priceAsc", "priceDesc"] }
          }
        ],
        "responses": {
          "200": {
            "description": "상품 목록",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductListResponse" }
              }
            }
          }
        }
      }
    },

    "/products/{productId}": {
      "get": {
        "summary": "상품 상세 조회",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "상품 상세",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductDetailResponse" }
              }
            }
          },
          "404": {
            "description": "상품 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/cart": {
  "get": {
    "summary": "내 장바구니 조회",
    "security": [{ "bearerAuth": [] }],
    "responses": {
      "200": {
        "description": "장바구니 조회 성공",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/CartResponse" }
          }
        }
      }
    }
  }
},

      "/cart/items": {
        "post": {
          "summary": "장바구니 상품 추가",
          "security": [{ "bearerAuth": [] }],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddCartItemRequest" }
              }
            }
          },
          "responses": {
            "201": {
              "description": "상품 추가 성공"
            },
            "400": {
              "description": "재고 부족",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                }
              }
            },
            "409": {
              "description": "장바구니 최대 개수 초과",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  },
                  "example": {
                    "code": "CART_LIMIT_EXCEEDED",
                    "message": "장바구니에는 최대 100개까지만 담을 수 있습니다"
                  }
                }
              }
            }
          }
        }
      },

      "/cart/items/{cartItemId}": {
        "patch": {
          "summary": "장바구니 상품 수량 변경",
          "security": [{ "bearerAuth": [] }],
          "parameters": [
            {
              "name": "cartItemId",
              "in": "path",
              "required": true,
              "schema": { "type": "integer" }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpdateCartItemRequest" }
              }
            }
          },
          "responses": {
            "200": { "description": "수량 변경 성공" }
          }
        },

        "delete": {
          "summary": "장바구니 상품 삭제",
          "security": [{ "bearerAuth": [] }],
          "parameters": [
            {
              "name": "cartItemId",
              "in": "path",
              "required": true,
              "schema": { "type": "integer" }
            }
          ],
          "responses": {
            "204": { "description": "삭제 성공" }
          }
        }
      },

      "/orders": {
        "post": {
          "summary": "주문 생성",
          "description": "장바구니 상품 선택 주문 또는 상품 바로 구매로 주문을 생성합니다.",
          "security": [{ "bearerAuth": [] }],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateOrderRequest" }
              }
            }
          },
          "responses": {
            "201": {
              "description": "주문 생성 성공",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/CreateOrderResponse" }
                }
              }
            },
            "400": {
              "description": "재고 부족",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/OutOfStockErrorResponse" }
                }
              }
            }
          }
        },

        "get": {
          "summary": "내 주문 목록 조회",
          "security": [{ "bearerAuth": [] }],
          "parameters": [
            { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
            { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } }
          ],
          "responses": {
            "200": {
              "description": "주문 목록 조회 성공",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/OrderListResponse" }
                }
              }
            }
          }
        }
      },

      "/orders/{orderId}": {
        "get": {
          "summary": "주문 상세 조회",
          "security": [{ "bearerAuth": [] }],
          "parameters": [
            {
              "name": "orderId",
              "in": "path",
              "required": true,
              "schema": { "type": "integer" }
            }
          ],
          "responses": {
            "200": {
              "description": "주문 상세 조회 성공",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/OrderDetailResponse" }
                }
              }
            },
            "403": {
              "description": "타인의 주문 조회",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/ErrorResponse" }
                }
              }
            }
          }
        }
      },

      "/payments": {
        "get": {
          "summary": "내 결제 내역 조회",
          "security": [{ "bearerAuth": [] }],
          "parameters": [
            { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
            { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } }
          ],
          "responses": {
            "200": {
              "description": "결제 내역 조회 성공",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/PaymentListResponse" }
                }
              }
            }
          }
        }
      }

    },

  "components": {
    "schemas": {
      "OAuthLoginResponse": {
        "type": "object",
        "properties": {
          "jwtToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/OAuthLoginResponse_user"
          }
        }
      },
      "OAuthLoginResponse_user": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "auth_oauth_body": {
        "required": [
          "accessToken",
          "provider"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "naver"
          },
          "accessToken": {
            "type": "string",
            "example": "ya29.a0AfH6SMA1234567890"
          }
        }
      },
      "ReissueTokenRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "rft_1234567890"
          }
        }
      },
       "ErrorResponse": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "example": "CART_LIMIT_EXCEEDED"
            },
            "message": {
              "type": "string"
            }
          }
        },
      "UserInfoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/UserInfoResponse_address"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserUpdateRequest": {
        "required": [
          "name",
          "phone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "example": "집"
          },
          "zipcode": {
            "type": "string",
            "example": "12345"
          },
          "road": {
            "type": "string",
            "example": "서울특별시 강남구 테헤란로 123"
          },
          "detail": {
            "type": "string",
            "example": "101동 1001호"
          },
          "isDefault": {
            "type": "boolean"
          }
        }
      },
      "AddressCreateRequest": {
        "required": ["name", "road", "zipcode"],
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "zipcode": { "type": "string" },
            "road": { "type": "string" },
            "detail": { "type": "string" },
            "isDefault": {
              "type": "boolean",
